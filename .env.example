# =============================================================================
# MonkeysMail Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
# NEVER commit the .env file to version control.
# =============================================================================

# --- Database ----------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ml_mail
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# --- Redis -------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
# REDIS_USERNAME=        # Redis 6+ ACL username
# REDIS_SCHEME=tcp       # Use 'tls' for encrypted connections
# REDIS_TLS=0            # Set to '1' to enable TLS

# --- SMTP (Outbound mail) ---------------------------------------------------
SMTP_HOST=smtp.monkeysmail.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TIMEOUT=15

# --- Authentication / JWT ----------------------------------------------------
AUTH_TOKEN=
JWT_SECRET=

# --- Queue -------------------------------------------------------------------
# DEV_INLINE_QUEUE=false  # Set to 'true' to bypass Redis and send inline
MAIL_STREAM=mail:outbound
MAIL_GROUP=senders

# --- Webhooks ----------------------------------------------------------------
WEBHOOK_QUEUE_KEY=webhooks:deliveries

# --- Segments ----------------------------------------------------------------
SEGMENT_STREAM=seg:builds
SEGMENT_GROUP=seg_builders
